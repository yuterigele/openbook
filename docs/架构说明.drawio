        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% 全局精细化样式定义\n    classDef layer-client fill:#E8F4FF,stroke:#1890FF,stroke-width:2px,rounded:6px\n    classDef layer-gateway fill:#F0F8FF,stroke:#13C2C2,stroke-width:2px,rounded:6px\n    classDef layer-security fill:#FFF2F2,stroke:#F53F3F,stroke-width:2px,rounded:6px\n    classDef layer-exec fill:#F6FFED,stroke:#52C41A,stroke-width:2px,rounded:6px\n    classDef layer-session fill:#FFF7E6,stroke:#FAAD14,stroke-width:2px,rounded:6px\n    classDef layer-core fill:#F9F0FF,stroke:#9254DE,stroke-width:2px,rounded:6px\n    classDef layer-reply fill:#E6FFFB,stroke:#36CFC9,stroke-width:2px,rounded:6px\n    classDef layer-infra fill:#F2F3F5,stroke:#86909C,stroke-width:2px,rounded:6px\n    classDef layer-monitor fill:#FFF1F0,stroke:#FF7875,stroke-width:2px,rounded:6px\n    classDef pass fill:#D9F7BE,stroke:#239B56,stroke-width:1.5px,rounded:4px\n    classDef reject fill:#FFE8E6,stroke:#CF1322,stroke-width:1.5px,rounded:4px\n\n    %% ① 客户端层\n    subgraph L1[\&quot;① 客户端层｜用户请求入口\&quot;]\n        direction LR\n        C1[\&quot;企微好友会话&lt;br/&gt;顾客添加店员发起对话\&quot;]\n        C2[\&quot;企微客服入口&lt;br/&gt;扫码/链接进入会话\&quot;]\n    end\n    class L1 layer-client\n\n    %% ② 接入层\n    subgraph L2[\&quot;② 接入层｜回调安全预处理\&quot;]\n        direction LR\n        G1[\&quot;签名校验&lt;br/&gt;拦截伪造请求\&quot;]\n        G2[\&quot;AES解密&lt;br/&gt;还原消息载荷\&quot;]\n        G3[\&quot;MsgId去重&lt;br/&gt;接口幂等防护\&quot;]\n        G4[\&quot;多店路由&lt;br/&gt;智能分发门店\&quot;]\n        G5[\&quot;注入shop_id&lt;br/&gt;全局身份溯源\&quot;]\n    end\n    class L2 layer-gateway\n\n    %% ③ 防护层\n    subgraph L3[\&quot;③ 防护层｜限流 + 风控 + 意图过滤\&quot;]\n        direction LR\n        S1[\&quot;三层限流&lt;br/&gt;用户/门店/全局管控\&quot;]\n        S2[\&quot;输入预检&lt;br/&gt;拦截空/超长/特殊字符\&quot;]\n        S3[\&quot;qwen-flash分类&lt;br/&gt;区分预约/闲聊/违规\&quot;]\n        S4{\&quot;业务意图判定\&quot;}\n        S5[\&quot;✅ 合法预约&lt;br/&gt;放行\&quot;]:::pass\n        S6[\&quot;❌ 非法内容&lt;br/&gt;拦截\&quot;]:::reject\n        \n        S1 --&gt; S2 --&gt; S3 --&gt; S4\n        S4 --&gt; S5\n        S4 --&gt; S6\n    end\n    class L3 layer-security\n\n    %% ④ 执行层\n    subgraph L4[\&quot;④ 执行层｜LLM并发调度与容错\&quot;]\n        direction LR\n        E1[\&quot;Channel削峰队列&lt;br/&gt;异步解耦流量\&quot;]\n        E2[\&quot;Worker工作池&lt;br/&gt;限制LLM最大并发\&quot;]\n        E3[\&quot;Panic隔离&lt;br/&gt;单任务故障不雪崩\&quot;]\n        E4[\&quot;超时熔断&lt;br/&gt;Context超时控制\&quot;]\n        E5[\&quot;负载判定&lt;br/&gt;满载繁忙/空闲下发\&quot;]\n        \n        S5 --&gt; E1 --&gt; E2 --&gt; E3 --&gt; E4 --&gt; E5\n    end\n    class L4 layer-exec\n\n    %% ⑤ 会话层\n    subgraph L5[\&quot;⑤ 会话层｜对话状态与上下文维护\&quot;]\n        direction LR\n        SE1[\&quot;双维度会话隔离&lt;br/&gt;顾客ID+门店ID\&quot;]\n        SE2[\&quot;Redis List存储&lt;br/&gt;留存对话历史\&quot;]\n        SE3[\&quot;3轮触发摘要&lt;br/&gt;精简冗余Token\&quot;]\n        SE4[\&quot;qwen-flash摘要&lt;br/&gt;保留核心诉求\&quot;]\n        SE5[\&quot;敏感词+鉴权&lt;br/&gt;实时内容防护\&quot;]\n        SE6[\&quot;可信上下文注入&lt;br/&gt;防客户端篡改\&quot;]\n        \n        E5 --&gt; SE1 --&gt; SE2 --&gt; SE3 --&gt; SE4 --&gt; SE5 --&gt; SE6\n    end\n    class L5 layer-session\n\n    %% ⑥ 核心Agent层\n    subgraph L6[\&quot;⑥ 核心层｜Agent智能引擎 &amp; 数据一致性\&quot;]\n        direction LR\n        CO1[\&quot;DeepSeek-V3&lt;br/&gt;高精度意图识别\&quot;]\n        CO2[\&quot;智能工具规划&lt;br/&gt;自动匹配业务能力\&quot;]\n        CO3[\&quot;四级模型降级&lt;br/&gt;全链路容错兜底\&quot;]\n        CO4[\&quot;工具白名单&lt;br/&gt;越权拦截管控\&quot;]\n        CO5[\&quot;查询工具组&lt;br/&gt;排班/技师/服务查询\&quot;]\n        CO6[\&quot;交易工具组&lt;br/&gt;创建/取消预约\&quot;]\n        CO7[\&quot;人工兜底组&lt;br/&gt;投诉/退款转接\&quot;]\n        CO8[\&quot;MySQL事务&lt;br/&gt;业务原子一致性\&quot;]\n        CO9[\&quot;Redis分布式锁&lt;br/&gt;防撞约超约\&quot;]\n        CO10[\&quot;qwen-flash润色&lt;br/&gt;口语化场景回复\&quot;]\n        \n        SE6 --&gt; CO1 --&gt; CO2 --&gt; CO3 --&gt; CO4 --&gt; CO5 &amp; CO6 &amp; CO7 --&gt; CO8 &amp; CO9 --&gt; CO10\n    end\n    class L6 layer-core\n\n    %% ⑦ 回复层\n    subgraph L7[\&quot;⑦ 回复层｜多渠道消息出口\&quot;]\n        direction LR\n        R1[\&quot;会话渠道自动适配\&quot;]\n        R2[\&quot;企微好友API回复\&quot;]\n        R3[\&quot;企微客服API回复\&quot;]\n        \n        CO10 --&gt; R1 --&gt; R2 &amp; R3\n    end\n    class L7 layer-reply\n\n    %% ⑧ 基础设施与容灾\n    subgraph L8[\&quot;⑧ 基础设施｜存储 &amp; 容灾降级体系\&quot;]\n        direction LR\n        INF1[\&quot;MySQL主从&lt;br/&gt;读写分离架构\&quot;]\n        INF2[\&quot;Redis核心能力&lt;br/&gt;限流/锁/缓存\&quot;]\n        INF3[\&quot;Redis心跳探测&lt;br/&gt;定时健康Ping\&quot;]\n        INF4{\&quot;熔断器状态判定\&quot;}\n        INF5[\&quot;熔断开启&lt;br/&gt;只读降级模式\&quot;]\n        INF6[\&quot;熔断恢复&lt;br/&gt;正常读写回归\&quot;]\n        INF7[\&quot;限流兜底&lt;br/&gt;本地令牌桶降级\&quot;]\n        INF8[\&quot;锁兜底&lt;br/&gt;MySQL唯一索引\&quot;]\n        INF9[\&quot;缓存兜底&lt;br/&gt;直查MySQL降级\&quot;]\n        INF10[\&quot;熔断状态&lt;br/&gt;飞书自动告警\&quot;]\n    end\n    class L8 layer-infra\n\n    %% ⑨ 可观测性\n    subgraph L9[\&quot;⑨ 可观测性｜全链路监控告警\&quot;]\n        direction LR\n        M1[\&quot;Prometheus&lt;br/&gt;全维度指标采集\&quot;]\n        M2[\&quot;ELK/Loki&lt;br/&gt;全链路日志聚合\&quot;]\n        M3[\&quot;飞书告警&lt;br/&gt;异常实时推送\&quot;]\n    end\n    class L9 layer-monitor\n\n    %% ========== 顶层主业务链路（新增） ==========\n    L1 --&gt; L2\n    L2 --&gt; L3\n\n    %% 全局依赖与监控穿透\n    L4 -.-&gt; L8\n    L5 -.-&gt; L8\n    L6 -.-&gt; L8\n    L1 -.-&gt; L9\n    L2 -.-&gt; L9\n    L3 -.-&gt; L9\n    L4 -.-&gt; L9\n    L5 -.-&gt; L9\n    L6 -.-&gt; L9\n    L7 -.-&gt; L9\n    L8 -.-&gt; L9&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="VLi5JAsi7axlgKlwOYAI-110">
